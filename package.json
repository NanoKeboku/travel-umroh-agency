{
  "name": "travel-umroh-agency",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Company Profile Website — Travel Umrah Ebitour Purworejo",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "seed": "node --experimental-strip-types scripts/seed.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name travel-umroh-agency",
    "db:migrate": "wrangler d1 migrations apply ebitour-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply ebitour-db --local",
    "db:seed": "npm run seed && npm run db:migrate"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
